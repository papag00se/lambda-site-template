---
import Base from '../layouts/Base.astro';

// Frontmatter is exported so Base.astro's auto-discovered nav can pick it
// up via import.meta.glob('../pages/*.{astro,mdx}'). Add a new .mdx page
// (or another .astro page with this same export) and it joins the nav.
//   - navLabel: text shown in the primary nav (omit to hide from nav)
//   - navOrder: sort order in the nav (lower = earlier)
//   - slug:     used to build the href and to resolve per-page CSS
export const frontmatter = {
    title: 'Lambda Site Template',
    description: 'An easy way to setup a Lambda site',
    slug: 'home',
    navLabel: 'Home',
    navOrder: 0
};
const { title, description, slug } = frontmatter;
---
<Base title={title} description={description} slug={slug}>
    <main class="home-wrapper">
        <header class="home-hero">
            <p class="home-eyebrow">SITE EYEBROW</p>
            <h1>Main explainer title</h1>
            <p class="home-hero__copy">One sentence explainer.</p>
            <div class="home-hero__cta">
                <a class="btn btn--primary" href="#" target="_blank" rel="noopener">Action!</a>
                <a class="btn btn--ghost" href="#">Secondary</a>
            </div>
        </header>

        <section class="home-panel home-panel--gradient" id="account">
            <div class="home-panel__content">
                <h2>Main flow call to action</h2>
                <ul class="home-steps">
                    <li class="home-steps__item">
                        <span class="home-steps__index">01</span>
                        <div class="home-steps__content">
                            <h3>Step 1</h3>
                            <p>Do this</p>
                        </div>
                    </li>
                    <li class="home-steps__item">
                        <span class="home-steps__index">02</span>
                        <div class="home-steps__content">
                            <h3>Step 2</h3>
                            <p>Then this</p>
                        </div>
                    </li>
                    <li class="home-steps__item">
                        <span class="home-steps__index">03</span>
                        <div class="home-steps__content">
                            <h3>Step 3</h3>
                            <p>And lastly this.</p>
                        </div>
                    </li>
                </ul>
            </div>
        </section>

        <section class="home-panel">
            <h2 class="home-panel__title">Main benefits/features</h2>
            <div class="home-features">
                <article class="home-feature">
                    <h3>Feature Callout 1</h3>
                    <p>Description</p>
                </article>
                <article class="home-feature">
                    <h3>Feature Callout 2</h3>
                    <p>Description</p>
                </article>
                <article class="home-feature">
                    <h3>Feature Callout 3</h3>
                    <p>Description</p>
                </article>
            </div>
        </section>

        <section class="home-panel home-panel--cta">
            <div class="home-cta">
                <h2>Bottom call to action</h2>
                <p>Easy process explainer</p>
                <div class="home-hero__cta">
                    <a class="btn btn--primary" href="#" target="_blank" rel="noopener">Action!</a>
                    <a class="btn btn--ghost" href="#">Secondary</a>
                </div>
            </div>
        </section>
    </main>
</Base>
